@model SistemaEstoque.Models.Usuario

@{
    ViewData["Title"] = "Login";
}

<div class="text-center">
    <h1 class="display-4">Entrar</h1>
</div>

    <form align="center" asp-controller="Login" asp-action="Login" method="post">
        <div class="form-label">
            <label asp-for="Nome">Nome: </label>
            <input asp-for="Nome"/>
        </div>

        <div class="form-label">
            <label asp-for="Senha">Senha: </label>
            <input asp-for="Senha"/>
        </div>

        <button type="submit">Entrar</button>

        <a asp-action="Cadastrar">Cadastrar-se</a>
    </form>
</div>